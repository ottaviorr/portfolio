---
import { Image } from 'astro:assets';
import ColorTitle from './ColorTitle.astro';
import { getProjects } from '../projects';
import { site } from '../site';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang).hero;
const base = lang === 'en' ? '/en/work/' : '/work/';
const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 2);
---

<section class="hero">
  <div class="pixels" aria-hidden="true"></div>

  <div class="hero-name">
    <ColorTitle as="h1" class="display" text={'Otávio\nHerdy.'} play />
    <span class="hero-alias" aria-hidden="true">{site.handle}</span>
  </div>

  <!-- projetos em cartões empilhados: o cliente vê o trabalho logo de cara; no hover abrem em leque -->
  <div class="stack">
    {
      featured.map((p, i) => (
        <a class:list={['stack-card', `c${i}`]} href={`${base}${p.id}/`} data-cursor="view">
          <Image src={p.data.gallery[0].src} widths={[480, 960]} sizes="440px" alt={p.data.title} />
          <span class="stack-tag">{p.data.title}</span>
        </a>
      ))
    }
  </div>

  <div class="hero-foot">
    <div class="hero-pitch">
      <p class="hero-role meta">{d.role}</p>
      <p class="hero-tagline">{d.tagline}</p>
      <a class="hero-cta" href="#contato" data-cursor="button">{d.cta} <span aria-hidden="true">→</span></a>
    </div>
    <p class="hero-meta meta">{d.location}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip; /* a esfera vaza pela direita no celular; não pode alargar a página */
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-6);
    padding: var(--space-12) var(--gutter) var(--space-4);
  }
  .hero > :not(.pixels, .stack) {
    position: relative;
    z-index: 1;
  }
  /* grade de pixels azul/rosa que aparece em volta do cursor (eco do dither das capas) */
  @property --mx {
    syntax: '<length>';
    inherits: true;
    initial-value: -999px;
  }
  @property --my {
    syntax: '<length>';
    inherits: true;
    initial-value: -999px;
  }
  .pixels {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(circle, var(--blue-light) 1.3px, transparent 1.8px) 0 0 / 14px 14px,
      radial-gradient(circle, var(--pink) 1.3px, transparent 1.8px) 7px 7px / 14px 14px;
    mask-image: radial-gradient(circle 260px at var(--mx) var(--my), #000, transparent);
    opacity: 0;
    transition:
      opacity 600ms,
      --mx 500ms var(--ease-out),
      --my 500ms var(--ease-out);
  }
  .hero:hover .pixels {
    opacity: 0.85;
  }
  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .pixels {
      display: none;
    }
  }
  /* cartões de projeto à direita do nome (só em telas largas, onde sobra espaço) */
  .stack {
    position: absolute;
    top: 46%;
    right: var(--gutter);
    z-index: 2;
    width: min(30vw, 440px);
    aspect-ratio: 16 / 11;
    translate: 0 -50%;
  }
  .stack-card {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.65);
    transition: transform 700ms var(--ease-out);
  }
  .stack-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .c0 {
    transform: rotate(-6deg) translate(-8%, 5%);
  }
  .c1 {
    transform: rotate(5deg) translate(6%, -6%);
  }
  .stack:hover .c0,
  .stack:focus-within .c0 {
    transform: rotate(-9deg) translate(-24%, 9%);
  }
  .stack:hover .c1,
  .stack:focus-within .c1 {
    transform: rotate(7deg) translate(20%, -10%);
  }
  .stack-tag {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    color: var(--white);
    font-size: var(--fs-meta);
    font-weight: 600;
  }
  @media (max-width: 1100px) {
    .stack {
      display: none; /* sem espaço ao lado do nome; os projetos estão logo abaixo */
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stack-card {
      transition: none;
    }
  }
  .hero-name {
    align-self: end;
    display: flex;
    align-items: flex-start;
    gap: clamp(0.5rem, 1.5vw, 1.5rem);
  }
  .hero-alias {
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(0.875rem, 1.6vw, 1.375rem);
    letter-spacing: 0.02em;
    color: var(--pink-light);
    padding-top: 0.4em;
  }
  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .hero-pitch {
    max-width: 36ch;
  }
  .hero-role {
    color: var(--blue-light);
    margin-bottom: var(--space-1);
  }
  .hero-tagline {
    font-size: var(--fs-body-lg);
    line-height: 1.45;
    text-wrap: balance;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    margin-top: var(--space-3);
    padding: 0 1.4rem;
    border-radius: 999px;
    background: var(--white);
    color: var(--bg);
    font-weight: 600;
    transition: background-color 200ms, color 200ms;
  }
  .hero-cta:hover {
    background: var(--pink);
    color: var(--ink);
  }
  .hero-cta span {
    transition: translate 200ms var(--ease-out);
  }
  .hero-cta:hover span {
    translate: 3px 0;
  }
  @media (max-width: 640px) {
    .hero-name {
      align-self: center;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero')!;
  hero.addEventListener('pointermove', (e) => {
    const r = hero.getBoundingClientRect();
    hero.style.setProperty('--mx', `${e.clientX - r.left}px`);
    hero.style.setProperty('--my', `${e.clientY - r.top}px`);
  });
</script>
