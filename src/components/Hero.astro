---
import ColorTitle from './ColorTitle.astro';
import { site } from '../site';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang).hero;
---

<section class="hero">
  <div class="pixels" aria-hidden="true"></div>
  <div class="orb" aria-hidden="true"></div>

  <div class="hero-name">
    <ColorTitle as="h1" class="display" text={'Otávio\nHerdy.'} play />
    <span class="hero-alias" aria-hidden="true">{site.handle}</span>
  </div>

  <div class="hero-foot">
    <div class="hero-pitch">
      <p class="hero-role meta">{d.role}</p>
      <p class="hero-tagline">{d.tagline}</p>
      <a class="hero-cta" href="#contato" data-cursor="button">{d.cta} <span aria-hidden="true">→</span></a>
    </div>
    <p class="hero-meta meta">{d.location}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip; /* a esfera vaza pela direita no celular; não pode alargar a página */
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-6);
    padding: var(--space-12) var(--gutter) var(--space-4);
  }
  .hero > :not(.pixels, .orb) {
    position: relative;
    z-index: 1;
  }
  /* grade de pixels azul/rosa que aparece em volta do cursor (eco do dither das capas) */
  @property --mx {
    syntax: '<length>';
    inherits: true;
    initial-value: -999px;
  }
  @property --my {
    syntax: '<length>';
    inherits: true;
    initial-value: -999px;
  }
  .pixels {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(circle, var(--blue-light) 1.3px, transparent 1.8px) 0 0 / 14px 14px,
      radial-gradient(circle, var(--pink) 1.3px, transparent 1.8px) 7px 7px / 14px 14px;
    mask-image: radial-gradient(circle 260px at var(--mx) var(--my), #000, transparent);
    opacity: 0;
    transition:
      opacity 600ms,
      --mx 500ms var(--ease-out),
      --my 500ms var(--ease-out);
  }
  .hero:hover .pixels {
    opacity: 0.85;
  }
  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .pixels {
      display: none;
    }
  }
  /* esfera em meio-tom: o degradê gira por trás de uma grade de pontos PARADA
     (pontos fixos não cintilam; só a cor flui). Ocupa o vazio à direita do nome. */
  @property --orb-a {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  .orb {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    z-index: 0;
    width: min(38vw, 560px);
    aspect-ratio: 1;
    translate: 0 -58%;
    pointer-events: none;
    background: conic-gradient(
      from var(--orb-a),
      var(--blue),
      var(--pink),
      var(--blue-light),
      var(--pink-light),
      var(--blue)
    );
    -webkit-mask:
      radial-gradient(circle, #000 2.3px, transparent 2.8px) 0 0 / 10px 10px,
      radial-gradient(closest-side, #000 55%, transparent);
    -webkit-mask-composite: source-in;
    mask:
      radial-gradient(circle, #000 2.3px, transparent 2.8px) 0 0 / 10px 10px,
      radial-gradient(closest-side, #000 55%, transparent);
    mask-composite: intersect;
    opacity: 0.95;
    animation: orb-spin 30s linear infinite;
  }
  @keyframes orb-spin {
    to {
      --orb-a: 360deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .orb {
      animation: none;
    }
  }
  @media (max-width: 640px) {
    .orb {
      top: 8%;
      right: -12%;
      width: 80vw;
      translate: none;
      opacity: 0.55;
    }
  }
  .hero-name {
    align-self: end;
    display: flex;
    align-items: flex-start;
    gap: clamp(0.5rem, 1.5vw, 1.5rem);
  }
  .hero-alias {
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(0.875rem, 1.6vw, 1.375rem);
    letter-spacing: 0.02em;
    color: var(--pink-light);
    padding-top: 0.4em;
  }
  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .hero-pitch {
    max-width: 36ch;
  }
  .hero-role {
    color: var(--blue-light);
    margin-bottom: var(--space-1);
  }
  .hero-tagline {
    font-size: var(--fs-body-lg);
    line-height: 1.45;
    text-wrap: balance;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    margin-top: var(--space-3);
    padding: 0 1.4rem;
    border-radius: 999px;
    background: var(--white);
    color: var(--bg);
    font-weight: 600;
    transition: background-color 200ms, color 200ms;
  }
  .hero-cta:hover {
    background: var(--pink);
    color: var(--ink);
  }
  .hero-cta span {
    transition: translate 200ms var(--ease-out);
  }
  .hero-cta:hover span {
    translate: 3px 0;
  }
  @media (max-width: 640px) {
    .hero-name {
      align-self: center;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero')!;
  hero.addEventListener('pointermove', (e) => {
    const r = hero.getBoundingClientRect();
    hero.style.setProperty('--mx', `${e.clientX - r.left}px`);
    hero.style.setProperty('--my', `${e.clientY - r.top}px`);
  });
</script>
