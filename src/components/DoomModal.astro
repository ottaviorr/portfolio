---
// Easter egg: DOOM (shareware) rodando em WebAssembly (doomgeneric) num <dialog>.
// Nada é baixado até alguém clicar em [data-doom-open] (o controle em "Um pouco de mim"): ~4.5MB em /public/doom.
// Desktop: janela retrô em pixel + teclado e mouse (pointer lock). Toque: vira um Game Boy.
import { t, type Lang } from '../i18n';
import cornerA from '../assets/corner-a.png';
import cornerB from '../assets/corner-b.png';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang).about.doom;

// mini controle (o mesmo sprite do "Um pouco de mim") como ícone da barra de título
const pad = [
  '..####..####..',
  '.############.',
  '###.######.###',
  '##...####.#.##',
  '###.######.###',
  '##############',
  '####......####',
  '.##........##.',
];
const icon = pad.flatMap((row, y) => [...row].flatMap((c, x) => (c === '#' ? [{ x, y }] : [])));
---

<dialog class="doom" aria-label={d.title}>
  <!-- detalhes do site em volta da janela (só desktop): pixel art nos cantos + selo girando -->
  <img class="doom-art a" src={cornerA.src} width="240" height="240" alt="" aria-hidden="true" />
  <img class="doom-art b" src={cornerB.src} width="240" height="240" alt="" aria-hidden="true" />
  <svg class="doom-badge" viewBox="0 0 120 120" aria-hidden="true">
    <defs><path id="doom-badge-circle" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0" /></defs>
    <circle cx="60" cy="60" r="58" />
    <text><textPath href="#doom-badge-circle" textLength="286" lengthAdjust="spacing">{d.badge + d.badge}</textPath></text>
    <rect x="52" y="52" width="16" height="16" />
  </svg>

  <div class="gb">
    <div class="win-bar">
      <span class="win-title"><svg class="win-icon" viewBox="0 0 14 8" shape-rendering="crispEdges" aria-hidden="true">{icon.map((p) => <rect x={p.x} y={p.y} width="1" height="1" />)}</svg>ottaviorr.exe<span class="win-sub">&nbsp;— {d.title}</span></span>
      <span class="led win-led" aria-hidden="true"></span>
      <button type="button" class="win-close" data-doom-close aria-label={d.close}>✕</button>
    </div>

    <div class="bezel">
      <span class="led gb-led" aria-hidden="true"></span>
      <p class="bezel-label" aria-hidden="true"><span></span>PIXEL MATRIX · NO SOUND<span></span></p>
      <div class="screen">
        <canvas width="640" height="400"></canvas>
        <div class="boot" aria-hidden="true">
          <p class="boot-logo">ottaviorr<span>.</span></p>
          <div class="boot-bar"><i></i></div>
          <p class="boot-pct">0%</p>
        </div>
        <p class="sr-only" aria-live="polite">{d.loading}</p>
        <div class="scan" aria-hidden="true"></div>
      </div>
    </div>

    <p class="brand" aria-hidden="true">ottaviorr<span>.</span> <i>GAME</i></p>
    <!-- status: uma linha limpa, no padrão do site (rótulo pequeno, sem enfeite) -->
    <div class="status" aria-hidden="true">
      <span class="st-mouse" data-free={d.mouseFree} data-locked={d.mouseLocked}>{d.mouseFree}</span>
      <span class="st-fps">-- FPS</span>
    </div>

    <!-- controles como a ficha das páginas de projeto: ação em rótulo pequeno, tecla em destaque -->
    <dl class="ctrl">
      {
        d.keys.map(([k, label], i) => (
          <div class:list={[i === 0 && 'is-blue', i === d.keys.length - 1 && 'is-pink']}>
            <dt>{label}</dt>
            <dd>{k}</dd>
          </div>
        ))
      }
    </dl>

    <!-- controle de toque (Game Boy): data-key = código de tecla do DOOM (doomkeys.h) -->
    <div class="pad" aria-hidden="true">
      <div class="dpad">
        <button type="button" class="up" data-key="173"></button>
        <button type="button" class="left" data-key="172"></button>
        <span class="mid"></span>
        <button type="button" class="right" data-key="174"></button>
        <button type="button" class="down" data-key="175"></button>
      </div>
      <div class="ab">
        <button type="button" class="b" data-key="162">B<small>{d.use}</small></button>
        <button type="button" class="a" data-key="163">A<small>{d.fire}</small></button>
      </div>
      <div class="sys">
        <button type="button" data-key="27"><span></span>Select</button>
        <button type="button" data-key="13"><span></span>Start</button>
      </div>
      <div class="grille"></div>
    </div>
  </div>
</dialog>

<style is:global>
  /* ── base / desktop: janela retrô em pixel ───────────────────── */
  .doom {
    margin: auto; /* o reset global zera a margem e tira o <dialog> do centro */
    /* largura limitada também pela altura: a tela é 16:10 e a moldura soma ~270px */
    width: min(92vw, 880px, calc((94svh - 270px) * 1.6));
    max-height: 96svh;
    padding: 12px; /* espaço pra borda e sombra em pixel */
    border: 0;
    background: none;
    color: var(--paper);
    overflow: visible;
  }
  .doom::backdrop {
    background:
      radial-gradient(circle, rgb(103 163 217 / 0.18) 1px, transparent 1.5px) 0 0 / 10px 10px,
      rgb(7 11 20 / 0.9);
  }
  .gb {
    position: relative;
    z-index: 1; /* acima da arte dos cantos */
    background: var(--ink);
    /* borda em degraus (4px) + sombra dura rosa: cara de janela de sistema antigo */
    box-shadow:
      0 -4px 0 0 var(--blue-light),
      0 4px 0 0 var(--blue-light),
      -4px 0 0 0 var(--blue-light),
      4px 0 0 0 var(--blue-light),
      10px 10px 0 2px var(--pink);
  }
  .win-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 6px 6px 12px;
    background: var(--blue);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .win-title {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .win-icon {
    width: 28px;
    height: 16px;
    fill: var(--pink);
  }
  .win-led {
    margin-left: auto; /* LED de "ligado" ao lado do fechar */
  }
  .win-close {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    font-weight: 800;
    box-shadow:
      inset -3px -3px 0 0 rgb(0 0 0 / 0.25),
      inset 3px 3px 0 0 #fff;
  }
  .win-close:hover {
    background: var(--pink);
  }
  .win-close:active {
    box-shadow: inset 3px 3px 0 0 rgb(0 0 0 / 0.25);
  }
  .bezel {
    padding: 12px;
  }
  .bezel-label {
    display: none;
  }
  .screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #000;
    cursor: crosshair;
  }
  .screen canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }
  /* linhas de CRT, bem leves */
  .scan {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(to bottom, rgb(0 0 0 / 0.18) 0 1px, transparent 1px 3px);
  }
  /* boot: o logo desce como o do Game Boy e a barra mostra o download de verdade */
  .boot {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 18px;
    background: #000;
  }
  .doom.is-ready .boot {
    display: none;
  }
  .boot-logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 5vw, 3rem);
    letter-spacing: -0.05em;
    color: var(--paper);
    animation: boot-drop 1.1s steps(11) both;
  }
  .boot-logo span {
    color: var(--pink);
  }
  @keyframes boot-drop {
    from {
      translate: 0 -220%;
    }
  }
  .boot-bar {
    width: min(60%, 260px);
    height: 14px;
    padding: 2px;
    border: 2px solid var(--blue-light);
  }
  .boot-bar i {
    display: block;
    width: var(--p, 0%);
    height: 100%;
    /* barra em blocos, não lisa */
    background: repeating-linear-gradient(to right, var(--pink) 0 8px, transparent 8px 10px);
  }
  .boot-pct {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--blue-light);
  }

  /* TV de tubo: liga numa linha que abre, desliga encolhendo pra um ponto */
  .doom[open] .screen {
    animation: crt-on 420ms ease-out both;
  }
  .doom.is-closing .screen {
    animation: crt-off 380ms ease-in both;
  }
  @keyframes crt-on {
    0% {
      transform: scale(1, 0.006);
      filter: brightness(4);
    }
    45% {
      transform: scale(1, 0.006);
      filter: brightness(3);
    }
    100% {
      transform: none;
      filter: none;
    }
  }
  @keyframes crt-off {
    0% {
      transform: none;
      filter: none;
    }
    55% {
      transform: scale(1, 0.006);
      filter: brightness(4);
    }
    100% {
      transform: scale(0, 0.006);
      filter: brightness(6);
    }
  }

  /* LED de energia: pisca carregando, acende rodando */
  .led {
    flex: none;
    width: 10px;
    height: 10px;
    background: #4a1f2e;
    box-shadow: 0 0 0 2px rgb(0 0 0 / 0.25);
    animation: doom-blink 0.6s steps(1) infinite;
  }
  .doom.is-ready .led {
    animation: none;
    background: var(--pink);
    box-shadow:
      0 0 0 2px rgb(0 0 0 / 0.25),
      0 0 10px 2px var(--pink);
  }
  @media (prefers-reduced-motion: reduce) {
    .boot-logo,
    .led,
    .doom[open] .screen,
    .doom.is-closing .screen {
      animation: none;
    }
  }
  .brand {
    display: none;
  }
  /* status e controles no padrão do site: linhas finas, rótulo pequeno, valor forte.
     Cores fixas (não do tema): a janela é sempre escura, até no tema claro. */
  .doom {
    --w-line: rgb(200 231 245 / 0.14);
    --w-muted: rgb(245 247 250 / 0.55);
  }
  .status {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 12px 0;
    font-size: var(--fs-meta);
    font-weight: 500;
    color: var(--w-muted);
    white-space: nowrap;
  }
  .st-mouse {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--blue-light);
  }
  .doom.is-locked .st-mouse {
    color: var(--pink);
  }
  .st-fps {
    font-variant-numeric: tabular-nums;
  }

  .ctrl {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    margin: 10px 12px 0;
    padding-bottom: 22px; /* respiro embaixo: o bloco não fica colado na borda da janela */
    border-top: 1px solid var(--w-line);
  }
  .ctrl div {
    display: grid;
    gap: 2px;
    padding: 12px 0 0 14px;
    border-left: 1px solid var(--w-line);
  }
  .ctrl div:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .ctrl dt {
    font-size: var(--fs-meta);
    font-weight: 500;
    color: var(--w-muted);
  }
  .ctrl dt::first-letter {
    text-transform: uppercase;
  }
  .ctrl dd {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    color: var(--paper);
  }
  .ctrl .is-blue dd {
    color: var(--blue-light);
  }
  .ctrl .is-pink dd {
    color: var(--pink);
  }

  /* pixel art do site espiando pelos cantos da janela + selo rosa girando */
  .doom-art {
    position: absolute;
    z-index: 0;
    width: 480px; /* 240px × 2: escala inteira, bloco nítido */
    height: 480px;
    max-width: none;
    image-rendering: pixelated;
    pointer-events: none;
  }
  .doom-art.a {
    top: -230px;
    left: -250px;
  }
  .doom-art.b {
    right: -240px;
    bottom: -250px;
    rotate: 180deg;
  }
  .doom-badge {
    position: absolute;
    z-index: 2;
    bottom: -70px; /* canto inferior esquerdo, pra fora: longe do ✕ e das teclas */
    left: -96px;
    width: 100px;
    height: 100px;
    animation: doom-spin 16s linear infinite;
  }
  .doom-badge circle {
    fill: var(--pink);
  }
  .doom-badge text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 10px;
    letter-spacing: 0.08em;
    fill: var(--ink);
  }
  .doom-badge rect {
    fill: var(--ink);
  }
  @keyframes doom-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .doom-badge {
    transform-origin: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .doom-badge {
      animation: none;
    }
  }

  /* o site esconde o cursor do sistema e desenha o próprio, mas o <dialog> fica na camada de cima
     (top layer) e o cursor custom ficava por trás: dentro do jogo volta o cursor normal */
  html.has-cursor .doom,
  html.has-cursor .doom * {
    cursor: auto !important;
  }
  html.has-cursor .doom button,
  html.has-cursor .doom button * {
    cursor: pointer !important;
  }
  html.has-cursor .doom .screen,
  html.has-cursor .doom .screen * {
    cursor: crosshair !important;
  }
  html:has(dialog.doom[open]) .cursor {
    display: none;
  }
  .pad,
  .gb-led {
    display: none;
  }
  @keyframes doom-blink {
    50% {
      opacity: 0;
    }
  }

  /* janela em telas médias: título curto e controles em duas linhas */
  @media (max-width: 1000px) {
    .win-sub {
      display: none;
    }
    .ctrl {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      row-gap: 10px;
    }
    .ctrl div:nth-child(4n + 1) {
      padding-left: 0;
      border-left: 0;
    }
  }

  /* ── toque OU tela estreita: Game Boy (também no modo celular do DevTools sem toque) ── */
  @media (hover: none), (pointer: coarse), (max-width: 760px) {
    .doom {
      width: 100vw;
      max-width: none;
      height: 100svh;
      max-height: none;
      margin: 0;
      padding: 12px;
      overflow: auto;
      background: var(--bg);
    }
    .doom::backdrop {
      background: var(--bg);
    }
    .gb {
      position: relative;
      max-width: 420px;
      min-height: calc(100svh - 24px);
      margin: 0 auto;
      padding: 14px 16px 24px;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      gap: 14px;
      background: color-mix(in srgb, var(--ice) 55%, var(--paper));
      color: var(--ink);
      border-radius: 14px 14px 72px 14px; /* o canto inferior direito arredondado do Game Boy */
      box-shadow:
        inset -4px -4px 0 0 rgb(0 0 0 / 0.12),
        inset 4px 4px 0 0 rgb(255 255 255 / 0.6);
    }
    .win-bar {
      padding: 0;
      background: none;
      color: color-mix(in srgb, var(--ink) 55%, transparent);
      font-size: 0.6875rem;
    }
    .win-icon,
    .win-led,
    .win-sub,
    .doom-art,
    .doom-badge,
    .status,
    .ctrl {
      display: none;
    }
    .win-close {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--ink);
      color: var(--paper);
      box-shadow: none;
    }
    .bezel {
      position: relative;
      padding: 10px 22px 22px;
      background: #3d4256;
      border-radius: 10px 10px 40px 10px;
    }
    /* LED de energia à esquerda da tela, como no Game Boy */
    .gb-led {
      display: block;
      position: absolute;
      left: 7px;
      top: 45%;
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }
    .bezel-label {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
      color: #c9ccd8;
      font-size: 0.5625rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      white-space: nowrap;
    }
    /* as duas faixas coloridas do Game Boy, nas cores do site */
    .bezel-label span {
      flex: 1;
      height: 6px;
      background: linear-gradient(var(--pink) 0 3px, var(--blue-light) 3px 6px);
    }
    .screen {
      border-radius: 2px;
      box-shadow: 0 0 0 3px #22252f;
    }
    .brand {
      display: block;
      margin-top: -4px;
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 1.375rem;
      letter-spacing: -0.04em;
      color: var(--blue);
    }
    .brand span {
      color: var(--pink);
    }
    .brand i {
      font-size: 0.875rem;
      letter-spacing: 0.08em;
      color: color-mix(in srgb, var(--ink) 55%, transparent);
    }

    .pad {
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'dpad ab'
        'sys sys'
        '. grille';
      align-items: center;
      row-gap: 18px;
      padding-top: 8px;
      user-select: none;
      -webkit-user-select: none;
      touch-action: none;
    }
    .pad button {
      border: 0;
      padding: 0;
      font: inherit;
      touch-action: none;
      -webkit-tap-highlight-color: transparent;
    }
    /* direcional em cruz */
    .dpad {
      grid-area: dpad;
      display: grid;
      grid-template-columns: repeat(3, 44px);
      grid-template-rows: repeat(3, 44px);
      filter: drop-shadow(0 3px 0 rgb(0 0 0 / 0.25));
    }
    .dpad button,
    .dpad .mid {
      background: var(--ink);
    }
    .dpad .up { grid-area: 1 / 2; border-radius: 6px 6px 0 0; }
    .dpad .left { grid-area: 2 / 1; border-radius: 6px 0 0 6px; }
    .dpad .mid { grid-area: 2 / 2; }
    .dpad .right { grid-area: 2 / 3; border-radius: 0 6px 6px 0; }
    .dpad .down { grid-area: 3 / 2; border-radius: 0 0 6px 6px; }
    .dpad button.is-down {
      background: var(--blue);
    }
    /* A e B inclinados, como no original */
    .ab {
      grid-area: ab;
      justify-self: end;
      display: flex;
      gap: 18px;
      rotate: -25deg;
      margin-right: 6px;
    }
    .ab button {
      display: grid;
      place-items: center;
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: var(--pink);
      color: var(--ink);
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 1.125rem;
      line-height: 1;
      box-shadow: 0 3px 0 0 rgb(0 0 0 / 0.25);
    }
    .ab .a {
      translate: 0 -14px;
    }
    .ab small {
      display: block;
      font-size: 0.5625rem;
      font-weight: 700;
      text-transform: uppercase;
    }
    .ab button.is-down {
      background: var(--pink-light);
      box-shadow: none;
    }
    /* Select / Start em pílula inclinada */
    .sys {
      grid-area: sys;
      justify-self: center;
      display: flex;
      gap: 22px;
    }
    .sys button {
      display: grid;
      justify-items: center;
      gap: 6px;
      background: none;
      color: color-mix(in srgb, var(--ink) 60%, transparent);
      font-size: 0.625rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .sys span {
      width: 44px;
      height: 12px;
      border-radius: 999px;
      background: #7d8396;
      rotate: -25deg;
    }
    .sys button.is-down span {
      background: var(--blue);
    }
    /* grade do alto-falante */
    .grille {
      grid-area: grille;
      justify-self: end;
      width: 70px;
      height: 44px;
      margin-right: 8px;
      rotate: -25deg;
      background: repeating-linear-gradient(to right, rgb(0 0 0 / 0.22) 0 4px, transparent 4px 10px);
      border-radius: 4px;
    }
  }
</style>

<script>
  type Doom = {
    _doomgeneric_Create(argc: number, argv: number): void;
    _doomgeneric_Tick(): void;
    _DG_GetFrameBuffer(): number;
    _DG_PushKeyEvent(pressed: number, key: number): void;
    _malloc(n: number): number;
    _free(p: number): void;
    HEAPU8: Uint8Array;
    setValue(p: number, v: number, t: string): void;
    FS_createPath(parent: string, path: string, r: boolean, w: boolean): void;
    FS_createDataFile(parent: string, name: string, data: Uint8Array, r: boolean, w: boolean): void;
  };

  const dialog = document.querySelector<HTMLDialogElement>('dialog.doom')!;
  const canvas = dialog.querySelector('canvas')!;
  const ctx = canvas.getContext('2d')!;
  const W = 640;
  const H = 400;
  let doom: Doom | null = null;
  let booting: Promise<void> | null = null;
  let running = false;

  const K = { LEFT: 0xac, UP: 0xad, RIGHT: 0xae, DOWN: 0xaf, STRAFE_L: 0xa0, STRAFE_R: 0xa1, USE: 0xa2, FIRE: 0xa3 };
  // guarda o que está apertado pra soltar tudo ao fechar (senão o boneco volta andando sozinho)
  const held = new Set<number>();
  const push = (on: boolean, key: number) => {
    if (!doom) return;
    if (on) held.add(key);
    else held.delete(key);
    doom._DG_PushKeyEvent(on ? 1 : 0, key);
  };
  const releaseAll = () => {
    held.forEach((k) => doom?._DG_PushKeyEvent(0, k));
    held.clear();
    dialog.querySelectorAll('.is-down').forEach((b) => b.classList.remove('is-down'));
  };

  // teclado → códigos do doomkeys.h
  const KEYS: Record<string, number> = {
    ArrowUp: K.UP, KeyW: K.UP,
    ArrowDown: K.DOWN, KeyS: K.DOWN,
    ArrowLeft: K.LEFT, ArrowRight: K.RIGHT,
    KeyA: K.STRAFE_L, KeyD: K.STRAFE_R,
    Space: K.USE, KeyE: K.USE,
    ControlLeft: K.FIRE, ControlRight: K.FIRE, KeyF: K.FIRE,
    ShiftLeft: 0x80 + 0x36, ShiftRight: 0x80 + 0x36, // correr
    Enter: 13, KeyM: 27, Tab: 9, Backspace: 127, // M abre o menu do DOOM (Esc fecha a janela)
  };
  const toDoom = (e: KeyboardEvent) =>
    KEYS[e.code] ?? (e.key.length === 1 ? e.key.toLowerCase().charCodeAt(0) : undefined); // letras/números (Y/N do menu, armas 1-7)

  function loadScript(src: string) {
    return new Promise<void>((ok, fail) => {
      const s = document.createElement('script');
      s.src = src;
      s.onload = () => ok();
      s.onerror = fail;
      document.head.append(s);
    });
  }

  // baixa somando os bytes recebidos pra barra de progresso do boot ser real
  const bar = dialog.querySelector<HTMLElement>('.boot-bar i')!;
  const pct = dialog.querySelector<HTMLElement>('.boot-pct')!;
  const TOTAL = 4_600_000; // ~ doom.wasm + doom1.wad (só pra barra; o download não depende disso)
  let loaded = 0;
  async function fetchCounted(url: string) {
    const res = await fetch(url);
    if (!res.ok || !res.body) throw new Error(url);
    const reader = res.body.getReader();
    const chunks: Uint8Array[] = [];
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      chunks.push(value);
      loaded += value.length;
      const p = Math.min(100, Math.round((loaded / TOTAL) * 100));
      bar.style.setProperty('--p', `${p}%`);
      pct.textContent = `${p}%`;
    }
    return new Blob(chunks).arrayBuffer();
  }

  async function boot() {
    const [wasm, wad] = await Promise.all([
      fetchCounted('/doom/doom.wasm'),
      fetchCounted('/doom/doom1.wad'),
      loadScript('/doom/doom.js'),
    ]);
    bar.style.setProperty('--p', '100%');
    pct.textContent = '100%';
    const create = (window as unknown as { createDoomModule: (m: object) => Promise<Doom> }).createDoomModule;
    doom = await create({
      wasmBinary: wasm,
      print: () => {},
      printErr: () => {},
      preRun: [
        (m: Doom) => {
          m.FS_createPath('/', 'doom', true, true);
          m.FS_createDataFile('/doom', 'doom1.wad', new Uint8Array(wad), true, false);
        },
      ],
    });
    // argv = ["doom", "-iwad", "/doom/doom1.wad"]
    const args = ['doom', '-iwad', '/doom/doom1.wad'];
    const ptrs = args.map((a) => {
      const p = doom!._malloc(a.length + 1);
      [...a].forEach((c, i) => doom!.setValue(p + i, c.charCodeAt(0), 'i8'));
      doom!.setValue(p + a.length, 0, 'i8');
      return p;
    });
    const argv = doom._malloc(ptrs.length * 4);
    ptrs.forEach((p, i) => doom!.setValue(argv + i * 4, p, 'i32'));
    doom._doomgeneric_Create(args.length, argv);
  }

  // ── mouse ──────────────────────────────────────────────────────
  // O doomgeneric só recebe teclas, então o mouse vira "segurar ←/→" proporcional ao movimento:
  // movementX enche um saldo de pixels e cada quadro consome um pedaço enquanto a tecla fica apertada.
  // ponytail: giro em velocidade de tecla; giro analógico exigiria exportar D_PostEvent no wasm.
  const PX_PER_FRAME = 10;
  let turnBudget = 0;
  let turnHeld = 0; // tecla de giro que o mouse está segurando (0 = nenhuma)
  function mouseTurn() {
    const want = Math.abs(turnBudget) > 2 ? (turnBudget > 0 ? K.RIGHT : K.LEFT) : 0;
    if (want !== turnHeld) {
      if (turnHeld) push(false, turnHeld);
      if (want) push(true, want);
      turnHeld = want;
    }
    if (want) turnBudget -= Math.sign(turnBudget) * Math.min(Math.abs(turnBudget), PX_PER_FRAME);
  }
  const locked = () => document.pointerLockElement === canvas;
  const stMouse = dialog.querySelector<HTMLElement>('.st-mouse')!;
  const stFps = dialog.querySelector<HTMLElement>('.st-fps')!;
  document.addEventListener('pointerlockchange', () => {
    dialog.classList.toggle('is-locked', locked());
    stMouse.textContent = locked() ? stMouse.dataset.locked! : stMouse.dataset.free!;
  });
  canvas.addEventListener('click', () => {
    if (!locked() && matchMedia('(pointer: fine)').matches) canvas.requestPointerLock();
  });
  document.addEventListener('mousemove', (e) => {
    if (locked()) turnBudget = Math.max(-400, Math.min(400, turnBudget + e.movementX));
  });
  canvas.addEventListener('mousedown', (e) => {
    if (!locked()) return;
    e.preventDefault();
    push(true, e.button === 2 ? K.USE : K.FIRE);
  });
  canvas.addEventListener('mouseup', (e) => {
    if (locked()) push(false, e.button === 2 ? K.USE : K.FIRE);
  });
  canvas.addEventListener('contextmenu', (e) => e.preventDefault());
  document.addEventListener('pointerlockchange', () => {
    if (locked()) return;
    // o navegador às vezes "come" o Esc só pra soltar o mouse: trata como sair também
    if (dialog.open && !closing) close();
    // saiu do modo mouse: solta tudo que o mouse segurava
    turnBudget = 0;
    if (turnHeld) push(false, turnHeld);
    turnHeld = 0;
    push(false, K.FIRE);
    push(false, K.USE);
  });

  // ── loop ───────────────────────────────────────────────────────
  const image = ctx.createImageData(W, H);
  const out = new Uint32Array(image.data.buffer);
  let frames = 0;
  let fpsT = performance.now();
  function frame() {
    if (!running || !doom) return;
    mouseTurn();
    doom._doomgeneric_Tick();
    // framebuffer ARGB (32 bits) → ImageData RGBA: troca R e B
    const src = new Uint32Array(doom.HEAPU8.buffer, doom._DG_GetFrameBuffer(), W * H);
    for (let i = 0; i < src.length; i++) {
      const p = src[i];
      out[i] = 0xff000000 | ((p & 0xff) << 16) | (p & 0xff00) | ((p >> 16) & 0xff);
    }
    ctx.putImageData(image, 0, 0);
    // FPS na barra de status (atualiza 2x por segundo)
    frames++;
    const now = performance.now();
    if (now - fpsT >= 500) {
      stFps.textContent = `${Math.round((frames * 1000) / (now - fpsT))} FPS`;
      frames = 0;
      fpsT = now;
    }
    requestAnimationFrame(frame);
  }

  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  async function open() {
    if (dialog.open) return;
    dialog.showModal();
    if (!booting) {
      // 1ª vez: o boot fica na tela pelo menos o tempo do logo descer
      booting = Promise.all([boot(), wait(1400)]).then(() => {
        dialog.classList.add('is-ready');
      });
    }
    try {
      await booting;
    } catch {
      pct.textContent = 'ERRO / ERROR';
      return;
    }
    if (!running && dialog.open) {
      running = true;
      requestAnimationFrame(frame);
    }
  }
  let closing = false;
  async function close() {
    if (!dialog.open || closing) return;
    closing = true;
    running = false; // pausa o loop; o jogo continua de onde parou se abrir de novo
    releaseAll();
    if (locked()) document.exitPointerLock();
    if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      dialog.classList.add('is-closing'); // TV de tubo desligando
      await wait(380);
    }
    dialog.close();
    dialog.classList.remove('is-closing');
    closing = false;
  }

  document.querySelectorAll('[data-doom-open]').forEach((b) => b.addEventListener('click', open));
  dialog.querySelector('[data-doom-close]')!.addEventListener('click', close);
  // Esc = sair de tudo, com um toque só: solta o mouse e fecha (com a animação de TV)
  dialog.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });
  // se o navegador fechar sozinho (ex.: Chrome ignora o preventDefault do Esc repetido), limpa igual
  dialog.addEventListener('close', () => {
    running = false;
    releaseAll();
    if (locked()) document.exitPointerLock();
  });
  addEventListener('blur', releaseAll); // trocou de aba/janela segurando tecla

  // código Konami em qualquer lugar do site também abre o DOOM
  const KONAMI = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
  let konami = 0;
  addEventListener('keydown', (e) => {
    if (dialog.open) return;
    konami = e.key.toLowerCase() === KONAMI[konami].toLowerCase() ? konami + 1 : e.key === 'ArrowUp' ? 1 : 0;
    if (konami === KONAMI.length) {
      konami = 0;
      open();
    }
  });

  const key = (pressed: boolean) => (e: KeyboardEvent) => {
    if (!dialog.open || !doom) return;
    if (e.key === 'Escape') {
      if (pressed) {
        e.preventDefault();
        close();
      }
      return;
    }
    const k = toDoom(e);
    if (k === undefined) return;
    e.preventDefault();
    if (pressed && e.repeat) return;
    push(pressed, k);
  };
  addEventListener('keydown', key(true));
  addEventListener('keyup', key(false));

  // controle de toque: segurar = tecla apertada; soltar/cancelar = solta
  dialog.querySelectorAll<HTMLButtonElement>('.pad [data-key]').forEach((b) => {
    const k = Number(b.dataset.key);
    const press = (on: boolean) => (e: PointerEvent) => {
      e.preventDefault();
      if (!doom || b.classList.contains('is-down') === on) return;
      b.classList.toggle('is-down', on);
      push(on, k);
    };
    b.addEventListener('pointerdown', (e) => {
      b.setPointerCapture(e.pointerId);
      press(true)(e);
    });
    b.addEventListener('pointerup', press(false));
    b.addEventListener('pointercancel', press(false));
    b.addEventListener('contextmenu', (e) => e.preventDefault());
  });
</script>
