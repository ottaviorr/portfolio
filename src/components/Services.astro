---
import ColorTitle from './ColorTitle.astro';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang).services;
---

<section class="section">
  <div class="head">
    <ColorTitle as="h2" class="h1" text={d.title} dot="blue" />
    <p class="intro">{d.intro}</p>
  </div>

  <ol class="cards">
    {
      d.items.map((s, i) => (
        <li class="card" data-spot data-rise data-tilt style={`--accent: var(${i % 2 ? '--pink' : '--blue-light'})`}>
          <span class="num" aria-hidden="true">0{i + 1}</span>
          <h3 class="h3">{s.name}</h3>
          <p class="text">{s.text}</p>
          <p class="sr-only">{d.includes}:</p>
          <ul class="tags">
            {s.tags.map((tag, j) => <li style={`--i:${j}`}>{tag}</li>)}
          </ul>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-3);
  }
  .intro {
    max-width: 28ch;
    color: var(--muted);
    font-size: var(--fs-body-lg);
  }
  .cards {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-8);
  }
  .card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-2);
    min-height: 20rem;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  /* brilho que segue o cursor: dá a sensação de superfície */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      circle at calc((var(--px) + 0.5) * 100%) calc((var(--py) + 0.5) * 100%),
      color-mix(in srgb, var(--white) 6%, transparent),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 400ms;
    pointer-events: none;
  }
  .card:hover::after {
    opacity: 1;
  }
  .num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--accent);
  }
  .card .h3 {
    margin-top: var(--space-4);
  }
  .text {
    max-width: 40ch;
    color: var(--muted);
  }
  .tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-2);
  }
  .tags li {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
  }
  @media (max-width: 760px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .card {
      min-height: 0;
      padding: var(--space-3);
    }
  }

  /* celular (sem hover): o card que passa pelo meio da tela "acende" —
     borda na cor dele, varredura da grade de pixels, número pulando em degraus e tags entrando */
  @media ((hover: none) or (max-width: 760px)) and (prefers-reduced-motion: no-preference) {
    .card {
      transition:
        transform 500ms var(--ease-out),
        border-color 400ms,
        box-shadow 400ms;
    }
    .card.is-active {
      border-color: color-mix(in srgb, var(--accent) 85%, transparent);
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 30%, transparent), 0 18px 40px -20px color-mix(in srgb, var(--accent) 45%, transparent);
      transform: scale(1.02);
    }
    .card.is-active::before {
      display: block;
      opacity: 0.55;
      --my: 130px; /* --my é registrado como <length> (px), % seria inválido */
      animation: card-scan 1.3s var(--ease-out) both;
    }
    .card.is-active .num {
      animation: num-pop 450ms steps(4) both;
    }
    .card.is-active .tags li {
      animation: tag-in 420ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 90ms + 250ms);
    }
  }
  @keyframes card-scan {
    from {
      --mx: -200px;
    }
    to {
      --mx: 300px;
    }
  }
  @keyframes num-pop {
    0% {
      scale: 0.6;
      opacity: 0.3;
    }
    60% {
      scale: 1.15;
    }
    100% {
      scale: 1;
      opacity: 1;
    }
  }
  @keyframes tag-in {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }
</style>

<script>
  // celular: marca o card que está cruzando o meio da tela (no desktop a classe não tem efeito)
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.target.classList.toggle('is-active', e.isIntersecting)),
    { rootMargin: '-40% 0px -40% 0px' },
  );
  document.querySelectorAll('.card').forEach((c) => io.observe(c));
</script>

