---
import ColorTitle from './ColorTitle.astro';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang).services;
---

<section class="section">
  <div class="head">
    <ColorTitle as="h2" class="h1" text={d.title} dot="blue" />
    <p class="intro">{d.intro}</p>
  </div>

  <ol class="cards">
    {
      d.items.map((s, i) => (
        <li class="card" data-spot data-rise style={`--accent: var(${i % 2 ? '--pink' : '--blue-light'})`}>
          <span class="num" aria-hidden="true">0{i + 1}</span>
          <h3 class="h3">{s.name}</h3>
          <p class="text">{s.text}</p>
          <p class="sr-only">{d.includes}:</p>
          <ul class="tags">
            {s.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-3);
  }
  .intro {
    max-width: 28ch;
    color: var(--muted);
    font-size: var(--fs-body-lg);
  }
  .cards {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-8);
  }
  .card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-2);
    min-height: 20rem;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    transition:
      border-color 300ms,
      transform 400ms var(--ease-out);
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    transform: translateY(-6px);
  }
  .num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--accent);
  }
  .card .h3 {
    margin-top: var(--space-4);
  }
  .text {
    max-width: 40ch;
    color: var(--muted);
  }
  .tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-2);
  }
  .tags li {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
  }
  @media (max-width: 760px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .card {
      min-height: 0;
      padding: var(--space-3);
    }
  }
</style>

