---
// Arte de canto em pixel art (dither azul/rosa, estilo Legency), atrás do conteúdo.
// A imagem tem 240px e é exibida a 4× (2× no celular): escala inteira + pixelated = bloco nítido
// que não cintila na rolagem. A seção que usa precisa da classe "has-corner".
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  corner: 'bottom-left' | 'bottom-right' | 'top-right';
}
const { src, corner } = Astro.props;
---

<img class:list={['px-corner', corner, 'is-off']} src={src.src} width={src.width} height={src.height} alt="" aria-hidden="true" decoding="async" />

<style is:global>
  .has-corner {
    position: relative;
    isolation: isolate; /* arte com z-index -1 fica atrás do texto, mas dentro da seção */
    overflow: clip; /* corta nos limites da seção: não alarga nem alonga a página */
  }
  .px-corner {
    position: absolute;
    z-index: -1;
    width: 960px;
    height: 960px;
    max-width: none;
    image-rendering: pixelated;
    pointer-events: none;
  }
  /* As duas sobem de um canto inferior e somem antes da borda da seção (sem corte reto).
     Só o trecho de cima da imagem aparece: o resto fica abaixo da seção, cortado. */
  .px-corner.bottom-left,
  .px-corner.bottom-right {
    bottom: -540px;
    mask-image: linear-gradient(to bottom, #000 26%, transparent 44%);
  }
  .px-corner.bottom-left {
    left: -280px;
  }
  /* desce do canto superior direito e some antes da borda de cima da seção */
  .px-corner.top-right {
    top: -540px;
    right: -320px;
    mask-image: linear-gradient(to top, #000 26%, transparent 44%);
  }
  /* entra "acendendo" em degraus (steps = cara de pixel) quando a seção chega na tela,
     e depois fica derivando devagar, como uma nuvem */
  @keyframes px-in {
    from {
      opacity: 0;
      scale: 0.82;
    }
  }
  @keyframes px-drift {
    to {
      translate: 18px -14px;
      rotate: 2deg;
    }
  }
  /* começa apagada; o script acende em degraus quando entra na tela */
  .px-corner.is-off {
    opacity: 0;
    scale: 0.82;
  }
  .px-corner.is-on {
    animation:
      px-in 900ms steps(7, end) both,
      px-drift 11s ease-in-out 900ms infinite alternate;
  }
  @media (prefers-reduced-motion: reduce) {
    .px-corner.is-off { opacity: 1; scale: 1; }
    .px-corner.is-on { animation: none; }
  }
  @media (max-width: 760px) {
    .px-corner {
      width: 480px;
      height: 480px;
      opacity: 0.7;
    }
    .px-corner.bottom-left,
    .px-corner.bottom-right {
      bottom: -270px;
    }
    .px-corner.bottom-left {
      left: -160px;
    }
    .px-corner.top-right {
      top: -270px;
      right: -175px;
    }
    .px-corner.bottom-right {
      right: -175px;
      bottom: -195px;
    }
  }
</style>

<script>
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      e.target.classList.replace('is-off', 'is-on');
      io.unobserve(e.target);
    }
  }, { threshold: 0.15 });
  document.querySelectorAll('.px-corner').forEach((el) => io.observe(el));
</script>
