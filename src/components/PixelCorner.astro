---
// Arte de canto em pixel art (dither azul/rosa, estilo Legency), atrás do conteúdo.
// A imagem tem 240px e é exibida a 4× (2× no celular): escala inteira + pixelated = bloco nítido
// que não cintila na rolagem. A seção que usa precisa da classe "has-corner".
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  corner: 'bottom-left' | 'bottom-right';
}
const { src, corner } = Astro.props;
---

<img class:list={['px-corner', corner]} src={src.src} width={src.width} height={src.height} alt="" aria-hidden="true" loading="lazy" decoding="async" />

<style is:global>
  .has-corner {
    position: relative;
    isolation: isolate; /* arte com z-index -1 fica atrás do texto, mas dentro da seção */
    overflow: clip; /* corta nos limites da seção: não alarga nem alonga a página */
  }
  .px-corner {
    position: absolute;
    z-index: -1;
    width: 960px;
    height: 960px;
    max-width: none;
    image-rendering: pixelated;
    pointer-events: none;
  }
  /* As duas sobem de um canto inferior e somem antes da borda da seção (sem corte reto).
     Só o trecho de cima da imagem aparece: o resto fica abaixo da seção, cortado. */
  .px-corner.bottom-left,
  .px-corner.bottom-right {
    bottom: -540px;
    mask-image: linear-gradient(to bottom, #000 26%, transparent 44%);
  }
  .px-corner.bottom-left {
    left: -280px;
  }
  /* Contato: o miolo rosa fica no canto inferior direito; some pra baixo (antes da faixa
     "Bora conversar") e em círculo na direção do e-mail */
  .px-corner.bottom-right {
    right: -300px;
    bottom: -350px;
    mask-image:
      linear-gradient(to bottom, #000 56%, transparent 66%),
      radial-gradient(circle at 62% 58%, #000 22%, transparent 38%);
    mask-composite: intersect;
  }
  @media (max-width: 760px) {
    .px-corner {
      width: 480px;
      height: 480px;
      opacity: 0.7;
    }
    .px-corner.bottom-left,
    .px-corner.bottom-right {
      bottom: -270px;
    }
    .px-corner.bottom-left {
      left: -160px;
    }
    .px-corner.bottom-right {
      right: -175px;
      bottom: -195px;
    }
  }
</style>
