---
// Abertura (~3s): as letras do nome entram piscando azul/rosa e assentam em branco.
// Só na 1ª visita da sessão e nunca com reduced-motion. Sem JS, não aparece.
const letters = [...'Otávio Herdy'];
---

<script is:inline>
  try {
    if (!sessionStorage.getItem('oh-seen') && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      document.documentElement.classList.add('is-loading');
      sessionStorage.setItem('oh-seen', '1');
    }
  } catch {}
</script>

<div class="preloader" aria-hidden="true">
  <p>
    {letters.map((ch, i) => <span style={`--i:${i}`}>{ch === ' ' ? ' ' : ch}</span>)}
  </p>
</div>

<style is:global>
  .preloader {
    display: none;
  }
  .is-loading .preloader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    background: var(--bg);
    pointer-events: none;
    animation: pre-out 1100ms cubic-bezier(0.65, 0, 0.35, 1) 2400ms forwards;
  }
  .preloader p {
    animation: pre-rise 1600ms cubic-bezier(0.16, 1, 0.3, 1) both;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 9vw, 7rem);
    letter-spacing: -0.05em;
  }
  /* letra inline (kerning intacto) e sem mexer posição: 'top' anda de pixel em pixel e
     dava degraus. Cada letra só desfoca/aparece; quem se move é a linha inteira (transform). */
  .preloader span {
    animation:
      pre-in 1300ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i) * 55ms) both,
      pre-blink 1700ms ease-in-out calc(var(--i) * 60ms) both;
  }
  @keyframes pre-in {
    from {
      opacity: 0;
      filter: blur(12px); /* entra desfocada e vai ganhando nitidez */
    }
  }
  @keyframes pre-rise {
    from {
      transform: translateY(0.35em);
    }
  }
  @keyframes pre-blink {
    /* degradê contínuo (antes era steps: trocava de cor aos saltos) */
    0% { color: var(--blue-light); }
    35% { color: var(--pink); }
    65% { color: var(--blue-light); }
    100% { color: var(--white); }
  }
  @keyframes pre-out {
    60% {
      opacity: 1;
    }
    to {
      translate: 0 -100%;
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
