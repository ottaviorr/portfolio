---
// Abertura (~3s): as letras do nome entram piscando azul/rosa e assentam em branco.
// Só na 1ª visita da sessão e nunca com reduced-motion. Sem JS, não aparece.
const letters = [...'Otávio Herdy'];
---

<script is:inline>
  try {
    if (!sessionStorage.getItem('oh-seen') && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      document.documentElement.classList.add('is-loading');
      sessionStorage.setItem('oh-seen', '1');
    }
  } catch {}
</script>

<div class="preloader" aria-hidden="true">
  <p>
    {letters.map((ch, i) => <span style={`--i:${i}`}>{ch === ' ' ? ' ' : ch}</span>)}
  </p>
</div>

<style is:global>
  .preloader {
    display: none;
  }
  .is-loading .preloader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    background: var(--bg);
    pointer-events: none;
    animation: pre-out 800ms cubic-bezier(0.76, 0, 0.24, 1) 2300ms forwards;
  }
  .preloader p {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 9vw, 7rem);
    letter-spacing: -0.05em;
  }
  /* inline + top relativo (não inline-block) pra manter o kerning entre as letras */
  .preloader span {
    position: relative;
    animation:
      pre-in 800ms var(--ease-out) calc(var(--i) * 70ms) both,
      pre-blink 1300ms steps(1) calc(var(--i) * 70ms) both;
  }
  @keyframes pre-in {
    from {
      opacity: 0;
      top: 0.4em;
    }
  }
  @keyframes pre-blink {
    0% { color: var(--blue-light); }
    20% { color: var(--pink); }
    40% { color: var(--blue-light); }
    60% { color: var(--pink); }
    80%, 100% { color: var(--white); }
  }
  @keyframes pre-out {
    to {
      translate: 0 -100%;
      visibility: hidden;
    }
  }
</style>
