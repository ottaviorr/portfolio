---
import { t, altPath, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const home = lang === 'en' ? '/en/' : '/';
const other = altPath(Astro.url.pathname, lang);
---

<header class="nav">
  <a href={home} class="logo">OH<span>.</span><span class="sr-only"> {d.nav.home}</span></a>
  <nav>
    <ul>
      <li><a href={`${home}#trabalhos`}>{d.nav.work}</a></li>
      <li><a href={`${home}#sobre`}>{d.nav.about}</a></li>
      <li><a href={`${home}#contato`}>{d.nav.contact}</a></li>
    </ul>
  </nav>
  <div class="tools">
  <button class="theme" type="button" aria-pressed="false" aria-label={d.nav.theme}>
    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor" /></svg>
  </button>
  <div class="lang" role="group" aria-label={d.nav.langLabel}>
    {lang === 'pt' ? <span aria-current="true">PT</span> : <a href={other} hreflang="pt-BR" lang="pt-BR">PT</a>}
    <span aria-hidden="true">/</span>
    {lang === 'en' ? <span aria-current="true">EN</span> : <a href={other} hreflang="en" lang="en">EN</a>}
  </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme')!;
  const root = document.documentElement;
  const meta = document.querySelector<HTMLMetaElement>('meta[name=theme-color]')!;
  const sync = () => {
    const light = root.dataset.theme === 'light';
    btn.setAttribute('aria-pressed', String(light));
    meta.content = light ? '#F5F7FA' : '#070B14'; // barra do navegador no celular acompanha o tema
  };
  sync();
  btn.addEventListener('click', () => {
    const light = root.dataset.theme !== 'light';
    if (light) root.dataset.theme = 'light';
    else delete root.dataset.theme;
    try {
      localStorage.setItem('theme', light ? 'light' : 'dark');
    } catch {}
    sync();
  });

  // seção atual fica destacada no menu (só na home, onde as seções existem)
  const links = [...document.querySelectorAll<HTMLAnchorElement>('nav a[href*="#"]')];
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        const link = links.find((a) => a.hash === '#' + e.target.id);
        if (!link) continue;
        if (e.isIntersecting) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    },
    { rootMargin: '-45% 0px -45% 0px' }, // conta como "atual" a seção que cruza o meio da tela
  );
  links.forEach((a) => {
    const el = document.getElementById(a.hash.slice(1));
    if (el) io.observe(el);
  });
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--gutter);
    font-size: 0.875rem;
    font-weight: 500;
    background: linear-gradient(var(--bg) 30%, transparent);
  }
  .logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.04em;
  }
  .logo span {
    color: var(--pink);
  }
  ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }
  nav a,
  .lang a,
  .lang [aria-current] {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.25rem;
  }
  nav a,
  .lang a {
    color: var(--muted);
    transition: color 200ms;
  }
  nav a:hover,
  .lang a:hover {
    color: var(--blue-light);
  }
  nav a[aria-current] {
    color: var(--white);
  }
  .tools {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .theme {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    transition: color 200ms, rotate 400ms var(--ease-out);
  }
  .theme:hover {
    color: var(--white);
  }
  .theme[aria-pressed='true'] {
    rotate: 180deg;
  }
  .theme svg {
    width: 18px;
    height: 18px;
  }
  .lang {
    align-items: center;
    line-height: 1;
    display: flex;
    gap: 0.35rem;
    color: var(--muted);
    font-size: var(--fs-meta);
  }
  .lang [aria-current] {
    color: var(--white);
  }
  @media (max-width: 640px) {
    .nav {
      grid-template-columns: auto 1fr auto;
      font-size: 0.8125rem;
    }
    nav ul {
      justify-content: center;
      gap: 0.5rem;
    }
    .tools {
      gap: 0;
    }
    .theme {
      width: 40px;
    }
  }
</style>
