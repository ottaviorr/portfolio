---
// Título com o efeito assinatura: cada letra acende em azul/rosa ao passar o mouse
// (ou tocar) e volta devagar pro branco. Split feito no build: zero layout shift.
// Quebra de linha forçada: use "\n" no texto.
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3' | 'p';
  class?: string;
  /** cor do ponto final, se o texto terminar em "." */
  dot?: 'blue' | 'pink';
  /** além da cor, a letra pula e gira um pouco (só no nome do hero) */
  play?: boolean;
}
const { text, as: Tag = 'h2', class: cls, dot = 'pink', play = false } = Astro.props;
const lines = text.split('\n');
const lastLine = lines.length - 1;
---

<Tag class:list={['ct', cls, play && 'ct--play']} data-ct>
  <span class="sr-only">{lines.join(' ')}</span>
  <span aria-hidden="true">
    {
      lines.map((line, li) => (
        <span class="ct-line">
          {line.split(' ').map((word, wi, words) => (
            <>
              {wi > 0 && ' '}
              <span class="ct-word">
                {[...word].map((ch, ci) => {
                  const isDot = ch === '.' && li === lastLine && wi === words.length - 1 && ci === word.length - 1;
                  return <span class:list={['ct-char', isDot && `ct-dot ct-dot--${dot}`]}>{ch}</span>;
                })}
              </span>
            </>
          ))}
        </span>
      ))
    }
  </span>
</Tag>

<style is:global>
  .ct-line {
    display: block;
  }
  .ct-word {
    white-space: nowrap;
  }
  /* inline (não inline-block) mantém o kerning entre letras */
  .ct-char {
    transition: color var(--dur-out) var(--ease-trail);
  }
  .ct-char.is-lit {
    color: var(--lit);
    transition-duration: var(--dur-in);
  }
  .ct-dot--pink {
    color: var(--pink);
  }
  .ct-dot--blue {
    color: var(--blue-light);
  }
  /* modo play: inline-block pra poder mover a letra; sobe rápido com mola e volta devagar.
     .ct--kerned só entra depois que o script compensou o kerning perdido (ver fitKerning) */
  .ct--play .ct-char {
    transition:
      color var(--dur-out) var(--ease-trail),
      transform 1100ms var(--ease-trail);
  }
  .ct--kerned .ct-char {
    display: inline-block;
    transition:
      color var(--dur-out) var(--ease-trail),
      transform 1100ms var(--ease-trail);
  }
  .ct--play .ct-char.is-lit {
    transform: translateY(var(--ty)) rotate(var(--rot)) scale(1.04);
    transition:
      color var(--dur-in),
      transform 380ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .ct-char,
    .ct--play .ct-char {
      transition: none;
    }
    .ct--play .ct-char.is-lit {
      transform: none;
    }
  }
</style>

<script>
  // tons claros: o efeito é um brilho, não um grito
  const colors = ['var(--blue-light)', 'var(--pink)'];
  const timers = new WeakMap<Element, number>();
  let n = 0;

  function light(el: Element | null) {
    const ch = el?.closest('.ct-char') as HTMLElement | null;
    if (!ch) return;
    // mesma letra ainda acesa: só estende, não troca de cor (evita "piscar")
    if (!ch.classList.contains('is-lit')) {
      ch.style.setProperty('--lit', colors[n++ % 2]);
      // direção e altura aleatórias: cada passada brinca diferente
      ch.style.setProperty('--rot', `${(Math.random() * 20 - 10).toFixed(1)}deg`);
      ch.style.setProperty('--ty', `${(-0.05 - Math.random() * 0.1).toFixed(3)}em`);
    }
    ch.classList.add('is-lit');
    clearTimeout(timers.get(ch));
    timers.set(ch, window.setTimeout(() => ch.classList.remove('is-lit'), 160));
  }

  // inline-block perde o kerning entre pares (ex.: "tá" encosta). Medimos onde cada letra
  // fica no texto normal (inline) e compensamos a diferença com margin depois do inline-block.
  function fitKerning(title: Element) {
    const chars = [...title.querySelectorAll<HTMLElement>('.ct-char')];
    title.classList.remove('ct--kerned');
    chars.forEach((c) => (c.style.marginLeft = ''));
    const target = chars.map((c) => c.getBoundingClientRect().left);
    title.classList.add('ct--kerned');
    chars.forEach((c, i) => {
      const diff = target[i] - c.getBoundingClientRect().left; // já inclui o ajuste das letras anteriores
      if (Math.abs(diff) > 0.1) c.style.marginLeft = `${diff}px`;
    });
  }
  const playTitles = document.querySelectorAll('.ct--play');
  if (playTitles.length && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const fitAll = () => playTitles.forEach(fitKerning);
    document.fonts.ready.then(fitAll);
    let raf = 0;
    addEventListener('resize', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(fitAll);
    });
  }

  for (const title of document.querySelectorAll('[data-ct]')) {
    title.addEventListener('pointerover', (e) => light(e.target as Element));
    // touch: pointer events ficam "presos" no alvo inicial, então seguimos o dedo à mão
    title.addEventListener(
      'touchmove',
      (e) => {
        const t = (e as TouchEvent).touches[0];
        light(document.elementFromPoint(t.clientX, t.clientY));
      },
      { passive: true },
    );
  }
</script>
