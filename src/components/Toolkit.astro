---
import ColorTitle from './ColorTitle.astro';
import PixelCorner from './PixelCorner.astro';
import cornerB from '../assets/corner-b.png';
import { toolkit } from '../site';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang).toolkit;
const tools = [
  ...toolkit.design.map((tool) => ({ ...tool, group: d.design, accent: 'var(--pink)' })),
  ...toolkit.ai.map((tool) => ({ ...tool, group: d.ai, accent: 'var(--pink)' })),
  ...toolkit.code.map((tool) => ({ ...tool, group: d.code, accent: 'var(--blue-light)' })),
];
---

<section class="section has-corner">
  <PixelCorner src={cornerB} corner="bottom-left" />
  <div class="head">
    <ColorTitle as="h2" class="h1" text={d.title} dot="blue" />
    <p class="intro">{d.intro}</p>
  </div>

  <ul class="tiles">
    {
      tools.map((tool) => (
        <li class="tile" data-rise style={`--accent: ${tool.accent}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={tool.icon.path} />
          </svg>
          <span class="name">{tool.name}</span>
          <span class="group meta">{tool.group}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-3);
  }
  .intro {
    max-width: 28ch;
    color: var(--muted);
    font-size: var(--fs-body-lg);
  }
  .tiles {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-8);
  }
  .tile {
    display: grid;
    grid-template-rows: 1fr auto auto;
    gap: 0.25rem;
    min-height: 11rem;
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    transition: border-color 300ms;
  }
  .tile:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  svg {
    width: 40px;
    height: 40px;
    fill: var(--white);
    transition: fill 300ms;
  }
  .tile:hover svg {
    fill: var(--accent);
  }
  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  @media (max-width: 900px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tile {
      min-height: 9rem;
    }
  }
</style>
