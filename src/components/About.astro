---
// Sobre: a frase-manifesto é o título; a foto vira uma polaroid inclinada com um selo girando.
import { Image } from 'astro:assets';
import ColorTitle from './ColorTitle.astro';
import photo from '../assets/otavio.jpg';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang).about;

// Sprites em pixel art (14×9), na ordem de d.off: código, videogame, notas musicais.
// "#" = pixel aceso. Mesma linguagem de "quadradinho" do dither do resto do site.
const sprites = [
  [
    '..............',
    '...#....#.#...',
    '..#.....#..#..',
    '.#.....#....#.',
    '#......#.....#',
    '.#....#.....#.',
    '..#...#....#..',
    '...#.#....#...',
    '..............',
  ],
  [
    '..............',
    '..####..####..',
    '.############.',
    '###.######.###',
    '##...####.#.##',
    '###.######.###',
    '##############',
    '####......####',
    '.##........##.',
  ],
  [
    '....##########',
    '....##########',
    '....##......##',
    '....##......##',
    '....##......##',
    '....##......##',
    '.#####...#####',
    '######..######',
    '.####....####.',
  ],
];
// cada pixel aceso vira um quadrado; xadrez de dois tons dá o efeito de dither
const pixels = sprites.map((rows) =>
  rows.flatMap((row, y) => [...row].flatMap((c, x) => (c === '#' ? [{ x, y, alt: (x + y) % 2 === 1 }] : []))),
);
const accents = ['var(--blue-light)', 'var(--pink)', 'var(--blue-light)'];
---

<section id="sobre" class="section about" aria-labelledby="about-statement">
  <p class="meta label">{d.title.replace('.', '')}</p>
  <div id="about-statement">
    <ColorTitle as="h2" class="h2 statement" text={d.statement} />
  </div>

  <div class="about-grid">
    <figure class="polaroid">
      <Image src={photo} alt={d.photoAlt} widths={[300, 600]} sizes="(max-width: 760px) 70vw, 300px" quality={85} />
      <figcaption>{d.caption}</figcaption>
      <svg class="badge" viewBox="0 0 120 120" aria-hidden="true">
        <defs><path id="badge-circle" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0" /></defs>
        <circle cx="60" cy="60" r="58" />
        <text><textPath href="#badge-circle" textLength="286" lengthAdjust="spacing">{d.badge.toUpperCase()}</textPath></text>
        <path class="badge-heart" d="M66.5 63c1-1 2-2.2 2-3.7a3.7 3.7 0 0 0-3.7-3.6c-1.2 0-2 .3-3 1.3-1-1-1.8-1.3-3-1.3a3.7 3.7 0 0 0-3.7 3.6c0 1.6 1 2.7 2 3.7l4.7 4.7Z" transform="translate(-2 -4) scale(1.05)" />
      </svg>
    </figure>

    <div class="about-body">
      <p class="about-text" set:html={d.text} />
      <h3 class="meta off-title" id="off-title">{d.offTitle}</h3>
      <!-- menu de videogame: lista de seleção à esquerda, "tela" com o item escolhido à direita.
           Sem JS, todos os painéis ficam visíveis em sequência. -->
      <div class="off" data-rise>
        <div class="off-menu" role="tablist" aria-labelledby="off-title">
          {
            d.off.map((o, i) => (
              <button
                type="button"
                role="tab"
                id={`off-tab-${i}`}
                aria-controls={`off-panel-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                style={`--accent: ${accents[i]}`}
              >
                <span class="caret" aria-hidden="true">▶</span>
                <span class="slot" aria-hidden="true">0{i + 1}</span>
                {o.name}
              </button>
            ))
          }
        </div>
        <div class="off-screen">
          {
            d.off.map((o, i) => (
              <div class="off-panel" role="tabpanel" id={`off-panel-${i}`} aria-labelledby={`off-tab-${i}`} style={`--accent: ${accents[i]}`}>
                {
                  // o controle (item de games) é o easter egg: clicar abre o DOOM
                  i === 1 ? (
                    <button type="button" class="egg" data-doom-open data-cursor="button" aria-label={d.doom.play}>
                      <span class="egg-bubble" aria-hidden="true">PRESS START</span>
                      <svg class="sprite" viewBox="0 0 14 9" shape-rendering="crispEdges" aria-hidden="true">
                        {pixels[i].map((p) => (
                          <rect x={p.x} y={p.y} width="1" height="1" class:list={[p.alt && 'alt']} style={`--d:${p.x + p.y}`} />
                        ))}
                      </svg>
                    </button>
                  ) : (
                    <svg class="sprite" viewBox="0 0 14 9" shape-rendering="crispEdges" aria-hidden="true">
                      {pixels[i].map((p) => (
                        <rect x={p.x} y={p.y} width="1" height="1" class:list={[p.alt && 'alt']} style={`--d:${p.x + p.y}`} />
                      ))}
                    </svg>
                  )
                }
                <p class="off-count meta" aria-hidden="true">0{i + 1} / 0{d.off.length}</p>
                <strong>{o.name}</strong>
                <p class="off-text">{o.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // abas acessíveis: hover/clique/setas trocam o item; só o painel ativo aparece
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.off-menu [role=tab]')];
  const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
  const select = (i: number, focus = false) => {
    tabs.forEach((t, j) => {
      const on = i === j;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      panels[j].hidden = !on;
    });
    if (focus) tabs[i].focus();
  };
  select(0);
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && select(i));
    t.addEventListener('keydown', (e) => {
      const k = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
      if (!k) return;
      e.preventDefault();
      select((i + k + tabs.length) % tabs.length, true);
    });
  });
</script>

<style>
  .label {
    margin-bottom: var(--space-2);
  }
  .about :global(.statement) {
    max-width: 18ch;
  }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
    margin-top: var(--space-12);
  }

  /* polaroid */
  .polaroid {
    position: relative;
    width: min(100%, 300px);
    justify-self: center;
    padding: 12px 12px 0;
    background: var(--paper);
    border-radius: 4px;
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.6);
    rotate: -4deg;
    transition:
      rotate 500ms var(--ease-out),
      scale 500ms var(--ease-out);
  }
  .polaroid:hover {
    rotate: 0deg;
    scale: 1.02;
  }
  .polaroid img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 2px;
  }
  figcaption {
    padding: 0.9rem 0.25rem 1rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: -0.01em;
  }
  .badge {
    position: absolute;
    top: -44px;
    right: -44px;
    width: 104px;
    height: 104px;
    transform-origin: center;
    animation: spin 18s linear infinite;
  }
  .badge circle {
    fill: var(--pink);
  }
  .badge text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 9.5px;
    letter-spacing: 0.08em;
    fill: var(--ink);
  }
  .badge-heart {
    fill: var(--ink);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .badge {
      animation: none;
    }
    .polaroid {
      transition: none;
    }
  }

  /* texto */
  .about-text {
    max-width: 46ch;
    font-size: var(--fs-body-lg);
    line-height: 1.6;
  }
  .about-text :global(mark) {
    --hl: color-mix(in srgb, var(--blue) 45%, transparent);
    color: inherit;
    background: linear-gradient(var(--hl), var(--hl)) no-repeat 0 0 / 100% 100%;
    padding: 0 0.1em;
  }
  .about-text :global(mark.pink) {
    --hl: color-mix(in srgb, var(--pink) 32%, transparent);
  }
  /* marca-texto pinta conforme o scroll (CSS nativo); sem suporte, já vem pintado */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .about-text :global(mark) {
        animation: paint linear both;
        animation-timeline: view();
        animation-range: entry 80% cover 50%;
      }
    }
  }
  @keyframes paint {
    from {
      background-size: 0% 100%;
    }
  }

  /* um pouco de mim: menu de videogame */
  .off-title {
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }
  .off {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
    gap: var(--space-4);
    align-items: stretch;
  }
  .off-menu {
    display: grid;
    align-content: start;
    border-top: 1px solid var(--line);
  }
  .off-menu button {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 56px;
    padding: 0 0.25rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    color: var(--muted);
    font: inherit;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    text-align: left;
    transition: color 200ms;
  }
  .slot {
    font-family: var(--font-body);
    font-size: var(--fs-meta);
    font-weight: 500;
  }
  .caret {
    width: 0.8em;
    font-size: 0.75rem;
    color: var(--accent);
    opacity: 0;
  }
  .off-menu [aria-selected='true'] {
    color: var(--white);
  }
  .off-menu [aria-selected='true'] .caret {
    opacity: 1;
    animation: blink 1s steps(1) infinite;
  }
  .off-menu [aria-selected='true'] .slot {
    color: var(--accent);
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* "tela": grade de pontos bem leve + cantos em colchete, sem caixa fechada */
  .off-screen {
    position: relative;
    padding: var(--space-4);
    background: radial-gradient(circle, color-mix(in srgb, var(--ice) 10%, transparent) 1px, transparent 1.5px) 0 0 / 12px 12px;
  }
  .off-screen::before,
  .off-screen::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    border: 2px solid var(--muted);
  }
  .off-screen::before {
    top: 0;
    left: 0;
    border-right: 0;
    border-bottom: 0;
  }
  .off-screen::after {
    right: 0;
    bottom: 0;
    border-left: 0;
    border-top: 0;
  }
  .off-panel {
    display: grid;
    gap: 0.5rem;
  }
  .off-panel + .off-panel {
    margin-top: var(--space-4); /* só sem JS, quando todos aparecem */
  }
  .off-panel[hidden] {
    display: none;
  }
  .sprite {
    width: 140px; /* 14 colunas × 10px: escala inteira, quadradinho nítido */
    height: 90px;
    margin-bottom: var(--space-2);
  }
  .sprite rect {
    fill: var(--accent);
  }
  .sprite rect.alt {
    fill: color-mix(in srgb, var(--accent) 55%, var(--white));
  }
  /* ao trocar de item, o sprite se monta pixel a pixel em diagonal */
  .off-panel:not([hidden]) .sprite rect {
    animation: px-build 360ms steps(2) both;
    animation-delay: calc(var(--d) * 20ms);
  }
  @keyframes px-build {
    from {
      opacity: 0;
    }
  }
  .off-count {
    color: var(--accent);
  }
  .off-panel strong {
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: -0.03em;
  }
  /* easter egg: o controle chama o clique — balão em pixel piscando + balanço de tempos em tempos */
  .egg {
    position: relative;
    justify-self: start;
    margin-top: var(--space-6); /* espaço pro balão */
    padding: 0;
    border: 0;
    background: none;
    animation: egg-wiggle 3.2s steps(1) infinite;
  }
  .egg .sprite {
    display: block;
    margin-bottom: var(--space-2);
    transition: scale 200ms steps(2);
  }
  .egg:hover .sprite,
  .egg:focus-visible .sprite {
    scale: 1.1;
  }
  .egg:hover {
    animation: none;
  }
  .egg-bubble {
    position: absolute;
    left: 50%;
    bottom: calc(100% - 4px);
    translate: -50% 0;
    padding: 4px 8px;
    border: 2px solid var(--accent);
    background: var(--bg);
    color: var(--accent);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    line-height: 1;
    white-space: nowrap;
    animation: egg-blink 1s steps(1) infinite;
  }
  /* rabinho do balão em 2 pixels (degrau), não triângulo liso */
  .egg-bubble::before,
  .egg-bubble::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 6px;
    height: 6px;
    background: var(--accent);
  }
  .egg-bubble::before {
    top: calc(100% + 2px);
    translate: -50% 0;
  }
  .egg-bubble::after {
    top: calc(100% + 8px);
    translate: -150% 0;
    width: 4px;
    height: 4px;
  }
  .egg:hover .egg-bubble,
  .egg:focus-visible .egg-bubble {
    animation: none;
    background: var(--accent);
    color: var(--ink);
  }
  @keyframes egg-blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes egg-wiggle {
    0%, 76%, 100% {
      rotate: 0deg;
    }
    80% {
      rotate: -6deg;
    }
    84% {
      rotate: 6deg;
    }
    88% {
      rotate: -4deg;
    }
    92% {
      rotate: 3deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .egg,
    .egg-bubble {
      animation: none;
    }
  }
  .off-text {
    max-width: 44ch;
    color: var(--muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .off-panel .sprite rect,
    .off-menu [aria-selected='true'] .caret {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .about-grid,
    .off {
      grid-template-columns: 1fr;
    }
    .sprite {
      width: 112px;
      height: 72px;
    }
    .about-grid {
      gap: var(--space-8);
    }
    .polaroid {
      width: min(70%, 280px);
    }
    .badge {
      top: -34px;
      right: -34px;
      width: 84px;
      height: 84px;
    }
  }
</style>
