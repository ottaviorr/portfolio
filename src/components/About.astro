---
// Sobre: a frase-manifesto é o título; a foto vira uma polaroid inclinada com um selo girando.
import { Image } from 'astro:assets';
import ColorTitle from './ColorTitle.astro';
import photo from '../assets/otavio.jpg';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang).about;

// ícones (traço, estilo Lucide) na ordem de d.off: música, videogame, rosa
const icons = [
  '<path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/>',
  '<line x1="6" x2="10" y1="11" y2="11"/><line x1="8" x2="8" y1="9" y2="13"/><line x1="15" x2="15.01" y1="12" y2="12"/><line x1="18" x2="18.01" y1="10" y2="10"/><path d="M17.32 5H6.68a4 4 0 0 0-3.98 3.59C2.6 9.42 2 14.46 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.41-1.41A2 2 0 0 1 9.83 16h4.34a2 2 0 0 1 1.41.59L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.55-.6-6.58-.69-7.26A4 4 0 0 0 17.32 5z"/>',
  '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
];
const accents = ['var(--blue-light)', 'var(--pink)', 'var(--pink)'];
---

<section id="sobre" class="section about" aria-labelledby="about-statement">
  <p class="meta label">{d.title.replace('.', '')}</p>
  <div id="about-statement">
    <ColorTitle as="h2" class="h2 statement" text={d.statement} />
  </div>

  <div class="about-grid">
    <figure class="polaroid">
      <Image src={photo} alt={d.photoAlt} widths={[300, 600]} sizes="(max-width: 760px) 70vw, 300px" quality={85} />
      <figcaption>{d.caption}</figcaption>
      <svg class="badge" viewBox="0 0 120 120" aria-hidden="true">
        <defs><path id="badge-circle" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0" /></defs>
        <circle cx="60" cy="60" r="58" />
        <text><textPath href="#badge-circle" textLength="286" lengthAdjust="spacing">{d.badge.toUpperCase()}</textPath></text>
        <path class="badge-heart" d="M66.5 63c1-1 2-2.2 2-3.7a3.7 3.7 0 0 0-3.7-3.6c-1.2 0-2 .3-3 1.3-1-1-1.8-1.3-3-1.3a3.7 3.7 0 0 0-3.7 3.6c0 1.6 1 2.7 2 3.7l4.7 4.7Z" transform="translate(-2 -4) scale(1.05)" />
      </svg>
    </figure>

    <div class="about-body">
      <p class="about-text" set:html={d.text} />
      <h3 class="meta off-title">{d.offTitle}</h3>
      <ul class="off">
        {
          d.off.map((o, i) => (
            <li data-spot data-rise style={`--accent: ${accents[i]}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[i]} />
              <strong>{o.name}</strong>
              <span>{o.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .label {
    margin-bottom: var(--space-2);
  }
  .about :global(.statement) {
    max-width: 18ch;
  }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
    margin-top: var(--space-12);
  }

  /* polaroid */
  .polaroid {
    position: relative;
    width: min(100%, 300px);
    justify-self: center;
    padding: 12px 12px 0;
    background: var(--paper);
    border-radius: 4px;
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.6);
    rotate: -4deg;
    transition:
      rotate 500ms var(--ease-out),
      scale 500ms var(--ease-out);
  }
  .polaroid:hover {
    rotate: 0deg;
    scale: 1.02;
  }
  .polaroid img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 2px;
  }
  figcaption {
    padding: 0.9rem 0.25rem 1rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: -0.01em;
  }
  .badge {
    position: absolute;
    top: -44px;
    right: -44px;
    width: 104px;
    height: 104px;
    transform-origin: center;
    animation: spin 18s linear infinite;
  }
  .badge circle {
    fill: var(--pink);
  }
  .badge text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 9.5px;
    letter-spacing: 0.08em;
    fill: var(--ink);
  }
  .badge-heart {
    fill: var(--ink);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .badge {
      animation: none;
    }
    .polaroid {
      transition: none;
    }
  }

  /* texto */
  .about-text {
    max-width: 46ch;
    font-size: var(--fs-body-lg);
    line-height: 1.6;
  }
  .about-text :global(mark) {
    --hl: color-mix(in srgb, var(--blue) 45%, transparent);
    color: inherit;
    background: linear-gradient(var(--hl), var(--hl)) no-repeat 0 0 / 100% 100%;
    padding: 0 0.1em;
  }
  .about-text :global(mark.pink) {
    --hl: color-mix(in srgb, var(--pink) 32%, transparent);
  }
  /* marca-texto pinta conforme o scroll (CSS nativo); sem suporte, já vem pintado */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .about-text :global(mark) {
        animation: paint linear both;
        animation-timeline: view();
        animation-range: entry 80% cover 50%;
      }
    }
  }
  @keyframes paint {
    from {
      background-size: 0% 100%;
    }
  }

  /* fora do expediente */
  .off-title {
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }
  .off {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }
  .off li {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    transition:
      border-color 300ms,
      transform 400ms var(--ease-out);
  }
  .off li:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    transform: translateY(-4px) rotate(-1deg);
  }
  .off svg {
    width: 28px;
    height: 28px;
    margin-bottom: var(--space-1);
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .off span {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .about-grid,
    .off {
      grid-template-columns: 1fr;
    }
    .about-grid {
      gap: var(--space-8);
    }
    .polaroid {
      width: min(70%, 280px);
    }
    .badge {
      top: -34px;
      right: -34px;
      width: 84px;
      height: 84px;
    }
  }
</style>
