---
// Sobre: a frase-manifesto é o título; a foto vira uma polaroid inclinada com um selo girando.
import { Image } from 'astro:assets';
import ColorTitle from './ColorTitle.astro';
import photo from '../assets/otavio.jpg';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang).about;

// Sprites em pixel art (14×9), na ordem de d.off: código, videogame, notas musicais.
// "#" = pixel aceso. Mesma linguagem de "quadradinho" do dither do resto do site.
const sprites = [
  [
    '..............',
    '...#....#.#...',
    '..#.....#..#..',
    '.#.....#....#.',
    '#......#.....#',
    '.#....#.....#.',
    '..#...#....#..',
    '...#.#....#...',
    '..............',
  ],
  [
    '..............',
    '..####..####..',
    '.############.',
    '###.######.###',
    '##...####.#.##',
    '###.######.###',
    '##############',
    '####......####',
    '.##........##.',
  ],
  [
    '....##########',
    '....##########',
    '....##......##',
    '....##......##',
    '....##......##',
    '....##......##',
    '.#####...#####',
    '######..######',
    '.####....####.',
  ],
];
// cada pixel aceso vira um quadrado; xadrez de dois tons dá o efeito de dither
const pixels = sprites.map((rows) =>
  rows.flatMap((row, y) => [...row].flatMap((c, x) => (c === '#' ? [{ x, y, alt: (x + y) % 2 === 1 }] : []))),
);
const accents = ['var(--blue-light)', 'var(--pink)', 'var(--blue-light)'];
---

<section id="sobre" class="section about" aria-labelledby="about-statement">
  <p class="meta label">{d.title.replace('.', '')}</p>
  <div id="about-statement">
    <ColorTitle as="h2" class="h2 statement" text={d.statement} />
  </div>

  <div class="about-grid">
    <figure class="polaroid">
      <Image src={photo} alt={d.photoAlt} widths={[300, 600]} sizes="(max-width: 760px) 70vw, 300px" quality={85} />
      <figcaption>{d.caption}</figcaption>
      <svg class="badge" viewBox="0 0 120 120" aria-hidden="true">
        <defs><path id="badge-circle" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0" /></defs>
        <circle cx="60" cy="60" r="58" />
        <text><textPath href="#badge-circle" textLength="286" lengthAdjust="spacing">{d.badge.toUpperCase()}</textPath></text>
        <path class="badge-heart" d="M66.5 63c1-1 2-2.2 2-3.7a3.7 3.7 0 0 0-3.7-3.6c-1.2 0-2 .3-3 1.3-1-1-1.8-1.3-3-1.3a3.7 3.7 0 0 0-3.7 3.6c0 1.6 1 2.7 2 3.7l4.7 4.7Z" transform="translate(-2 -4) scale(1.05)" />
      </svg>
    </figure>

    <div class="about-body">
      <p class="about-text" set:html={d.text} />
      <h3 class="meta off-title">{d.offTitle}</h3>
      <ul class="off">
        {
          d.off.map((o, i) => (
            <li data-rise style={`--accent: ${accents[i]}`}>
              <svg class="sprite" viewBox="0 0 14 9" shape-rendering="crispEdges" aria-hidden="true">
                {pixels[i].map((p) => (
                  <rect x={p.x} y={p.y} width="1" height="1" class:list={[p.alt && 'alt']} style={`--d:${p.x + p.y}`} />
                ))}
              </svg>
              <strong>{o.name}</strong>
              <span>{o.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .label {
    margin-bottom: var(--space-2);
  }
  .about :global(.statement) {
    max-width: 18ch;
  }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
    margin-top: var(--space-12);
  }

  /* polaroid */
  .polaroid {
    position: relative;
    width: min(100%, 300px);
    justify-self: center;
    padding: 12px 12px 0;
    background: var(--paper);
    border-radius: 4px;
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.6);
    rotate: -4deg;
    transition:
      rotate 500ms var(--ease-out),
      scale 500ms var(--ease-out);
  }
  .polaroid:hover {
    rotate: 0deg;
    scale: 1.02;
  }
  .polaroid img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 2px;
  }
  figcaption {
    padding: 0.9rem 0.25rem 1rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: -0.01em;
  }
  .badge {
    position: absolute;
    top: -44px;
    right: -44px;
    width: 104px;
    height: 104px;
    transform-origin: center;
    animation: spin 18s linear infinite;
  }
  .badge circle {
    fill: var(--pink);
  }
  .badge text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 9.5px;
    letter-spacing: 0.08em;
    fill: var(--ink);
  }
  .badge-heart {
    fill: var(--ink);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .badge {
      animation: none;
    }
    .polaroid {
      transition: none;
    }
  }

  /* texto */
  .about-text {
    max-width: 46ch;
    font-size: var(--fs-body-lg);
    line-height: 1.6;
  }
  .about-text :global(mark) {
    --hl: color-mix(in srgb, var(--blue) 45%, transparent);
    color: inherit;
    background: linear-gradient(var(--hl), var(--hl)) no-repeat 0 0 / 100% 100%;
    padding: 0 0.1em;
  }
  .about-text :global(mark.pink) {
    --hl: color-mix(in srgb, var(--pink) 32%, transparent);
  }
  /* marca-texto pinta conforme o scroll (CSS nativo); sem suporte, já vem pintado */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .about-text :global(mark) {
        animation: paint linear both;
        animation-timeline: view();
        animation-range: entry 80% cover 50%;
      }
    }
  }
  @keyframes paint {
    from {
      background-size: 0% 100%;
    }
  }

  /* fora do expediente */
  .off-title {
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }
  .off {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  /* sem caixa: sprite em pixel art + texto, separados só por uma linha (menos "card padrão") */
  .off li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .sprite {
    width: 84px; /* 14 colunas × 6px: escala inteira, quadradinho nítido */
    height: 54px;
    margin-bottom: var(--space-1);
  }
  .sprite rect {
    fill: var(--accent);
  }
  .sprite rect.alt {
    fill: color-mix(in srgb, var(--accent) 55%, var(--white));
  }
  /* no hover os pixels se montam em diagonal, um a um */
  .off li:hover .sprite rect {
    animation: px-build 420ms steps(2) both;
    animation-delay: calc(var(--d) * 22ms);
  }
  @keyframes px-build {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .off li:hover .sprite rect {
      animation: none;
    }
  }
  .off strong {
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    color: var(--white);
  }
  .off span {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .about-grid,
    .off {
      grid-template-columns: 1fr;
    }
    .about-grid {
      gap: var(--space-8);
    }
    .polaroid {
      width: min(70%, 280px);
    }
    .badge {
      top: -34px;
      right: -34px;
      width: 84px;
      height: 84px;
    }
  }
</style>
