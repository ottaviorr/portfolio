---
// Faixa fina de palavras-chave passando devagar (sentido oposto ao "Bora conversar").
// Decorativa: o mesmo conteúdo está nos serviços, então fica fora da árvore de acessibilidade.
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const words = t(lang).ticker;
const run = [...words, ...words];
---

<div class="ticker" aria-hidden="true">
  <div class="track">
    {[...run, ...run].map((w, i) => <span>{w}<i class:list={[i % 2 ? 'pink' : 'blue']}>✦</i></span>)}
  </div>
</div>

<style>
  .ticker {
    overflow: hidden;
    padding: var(--space-2) 0;
    border-block: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.125rem, 2vw, 1.75rem);
    letter-spacing: -0.03em;
    color: var(--muted);
    white-space: nowrap;
  }
  .track {
    display: flex;
    width: max-content;
    animation: ticker 70s linear infinite reverse;
  }
  i {
    font-style: normal;
    font-size: 0.6em;
    vertical-align: middle;
    padding-inline: 0.9em;
  }
  .blue {
    color: var(--blue-light);
  }
  .pink {
    color: var(--pink);
  }
  @keyframes ticker {
    to {
      translate: -50% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
